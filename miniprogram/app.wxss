/* 暗夜金 · 加氛围：深色底、细线分组、暗色面板托底；数字衬线体，金棕三色区分营养素。规范见 总控制/collaboration/shiguang/设计规范.md */
page {
  --bg: #121110;
  --surface: #1c1a16;
  --panel: #1a1916;
  --panel-2: #24221d;
  --line: rgba(255, 248, 230, 0.06);
  --line-strong: rgba(255, 248, 230, 0.1);
  --text: #ede6d6;
  --text-soft: #8f8776;
  --text-faint: #5e584c;
  --gold: #c9a96e;
  --gold-soft: #8f7a52;
  --ink: #14130f;
  --danger: #d98c7a;
  --c-carb: #e2c48a;
  --c-protein: #b98457;
  --c-fat: #8c826d;
  background: var(--bg);
  color: var(--text);
  font-family: "PingFang SC", -apple-system, "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

.wrap { padding: 32rpx 40rpx 64rpx; }

/* 上下双光：顶部金光 + 右下铜光，固定在视口，内容在上面滚动 */
.ambient {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: -1;
  pointer-events: none;
  background:
    radial-gradient(130% 50% at 25% 0%, rgba(214, 182, 122, 0.24), rgba(214, 182, 122, 0) 60%),
    radial-gradient(120% 45% at 80% 100%, rgba(185, 132, 87, 0.22), rgba(185, 132, 87, 0) 65%),
    var(--bg);
}
.num { font-family: "Songti SC", "STSong", "Noto Serif", Georgia, serif; font-weight: 400; }
.serif { font-family: "Songti SC", "STSong", "Noto Serif SC", serif; }
.soft { color: var(--text-soft); }
.faint { color: var(--text-faint); }
.small { font-size: 24rpx; }
.gold { color: var(--gold); }
.danger { color: var(--danger); }
.press { opacity: 0.6; }

.h1 { font-size: 40rpx; font-weight: 500; }
.h2 { font-size: 30rpx; font-weight: 500; }
.label { font-size: 22rpx; letter-spacing: 4rpx; color: var(--gold); }

/* 区块：无底色无边框，只靠上方一条强调线分组 */
.card {
  border-top: 1rpx solid var(--line-strong);
  padding: 28rpx 0;
}

/* 营养总览：圆环 + 大号热量 + 一行四项 */
.nutri { margin-bottom: 16rpx; }
.nutri-head { display: flex; align-items: center; padding: 16rpx 0 36rpx; }
.ring {
  width: 168rpx;
  height: 168rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ring-hole { width: 136rpx; height: 136rpx; border-radius: 50%; background: var(--bg); }
.nutri-label { font-size: 22rpx; color: var(--text-soft); letter-spacing: 2rpx; }
.nutri-kcal { font-size: 80rpx; line-height: 1.05; color: var(--text); }
.nutri-kcal-unit { font-size: 24rpx; margin-left: 12rpx; color: var(--text-soft); }
.nutri-row {
  display: flex;
  border-top: 1rpx solid var(--line-strong);
  border-bottom: 1rpx solid var(--line-strong);
  padding: 22rpx 0;
}
.nutri-cell { flex: 1; }
/* 圆环图例：与 ringStyle 三段颜色对应 */
.dot { display: inline-block; width: 10rpx; height: 10rpx; border-radius: 50%; margin-right: 10rpx; vertical-align: 4rpx; }
.dot.c { background: var(--c-carb); }
.dot.p { background: var(--c-protein); }
.dot.f { background: var(--c-fat); }

/* 食材分类圆标 */
.badge {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: var(--panel-2);
  font-size: 22rpx;
  line-height: 52rpx;
  text-align: center;
  flex-shrink: 0;
  margin-right: 20rpx;
}
.badge.c { color: var(--c-carb); }
.badge.p { color: var(--c-protein); }
.badge.f { color: var(--c-fat); }
.nutri-cell .v { font-size: 36rpx; }
.nutri-cell .u { font-size: 20rpx; margin-left: 4rpx; color: var(--text-soft); }

/* 按钮 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  background: var(--gold);
  color: var(--ink);
  font-weight: 500;
  letter-spacing: 2rpx;
}
.btn.ghost { background: transparent; color: var(--text); border: 1rpx solid var(--line-strong); font-weight: 400; }
.btn.danger { background: transparent; color: var(--danger); border: 1rpx solid #4a322c; font-weight: 400; }
.btn.disabled { opacity: 0.4; }
.btn-row { display: flex; gap: 20rpx; margin-top: 40rpx; }
.btn-row .btn { flex: 1; }

/* 分类筛选：无框，选中金字 + 下方短线 */
.chips { white-space: nowrap; margin: 0 -40rpx 16rpx; padding: 0 40rpx; }
.chip {
  display: inline-block;
  position: relative;
  padding: 12rpx 0 18rpx;
  margin-right: 44rpx;
  color: var(--text-soft);
  font-size: 26rpx;
}
.chip.on { color: var(--gold); }
.chip.on::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 4rpx;
  width: 24rpx;
  height: 4rpx;
  margin-left: -12rpx;
  border-radius: 2rpx;
  background: var(--gold);
}

/* 分段切换：文字 + 金色下划线 */
.seg { display: flex; border-bottom: 1rpx solid var(--line); margin-bottom: 32rpx; }
.seg-item { flex: 1; text-align: center; padding: 20rpx 0; color: var(--text-faint); position: relative; }
.seg-item.on { color: var(--text); }
.seg-item.on::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: -1rpx;
  width: 64rpx;
  height: 2rpx;
  margin-left: -32rpx;
  background: var(--gold);
}

/* 输入 */
.search {
  display: flex;
  align-items: center;
  height: 80rpx;
  padding: 0 32rpx;
  border-radius: 40rpx;
  background: rgba(255, 248, 230, 0.05);
  margin-bottom: 20rpx;
}
.search input { flex: 1; color: var(--text); font-size: 28rpx; }
.ph { color: var(--text-faint); }

.field { margin-bottom: 32rpx; }
.field-label { font-size: 24rpx; color: var(--text-soft); margin-bottom: 12rpx; letter-spacing: 2rpx; }
.input {
  height: 88rpx;
  padding: 0 28rpx;
  border-radius: 12rpx;
  background: var(--surface);
  color: var(--text);
  font-size: 30rpx;
  display: flex;
  align-items: center;
}
.input input { flex: 1; color: var(--text); }

/* 列表行 */
.row { display: flex; align-items: center; justify-content: space-between; }
.grow { flex: 1; min-width: 0; }
.ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.macros { display: flex; flex-wrap: wrap; gap: 4rpx 24rpx; font-size: 24rpx; color: var(--text-soft); margin-top: 8rpx; }

.empty { text-align: center; color: var(--text-faint); padding: 80rpx 0; }

/* 底部弹层 */
.mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; background: rgba(0, 0, 0, 0.6); z-index: 10; }
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 11;
  background: var(--surface);
  border-top: 1rpx solid var(--line-strong);
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  padding: 40rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  max-height: 85vh;
  box-sizing: border-box;
  overflow-y: auto;
}

/* 三项营养：色线 + 数字 + 名称（配餐首页、统计、食谱详情共用） */
.macros3 { display: flex; gap: 28rpx; }
.macros3 .m { flex: 1; }
.macros3 .m-line { height: 4rpx; border-radius: 2rpx; }
.macros3 .m.c .m-line { background: var(--c-carb); }
.macros3 .m.p .m-line { background: var(--c-protein); }
.macros3 .m.f .m-line { background: var(--c-fat); }
.macros3 .m-v { font-size: 36rpx; margin-top: 18rpx; }
.macros3 .m-l { font-size: 22rpx; color: var(--text-soft); }

/* 大号热量 */
.big-kcal { font-size: 96rpx; line-height: 1; color: #f5e6c2; }
.big-unit { font-size: 24rpx; color: var(--text-soft); margin-top: 12rpx; }

/* 极简列表行：名称 + 右侧数字，细线分隔 */
.list { border-top: 1rpx solid var(--line-strong); }
.li { min-height: 104rpx; border-bottom: 1rpx solid var(--line-strong); box-sizing: border-box; padding: 20rpx 0; }
.li-sub { font-size: 22rpx; color: var(--text-soft); margin-top: 4rpx; }
.li-num { flex-shrink: 0; margin-left: 24rpx; font-size: 30rpx; color: var(--c-carb); }
.li-num.dim { color: var(--text-soft); }
.page-title { font-size: 44rpx; font-weight: 600; letter-spacing: 2rpx; margin: 8rpx 0 40rpx; }
