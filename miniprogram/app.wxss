/* 配色沿用 食光 网页版：深色底 + 米金色点缀 */
page {
  --bg: #161918;
  --card: #202421;
  --muted: #272d29;
  --border: #363e38;
  --text: #eeefeb;
  --text-soft: #aaafa9;
  --gold: #ddcba5;
  --paper: #dcd8cc;
  --ink: #232823;
  --danger: #f3a699;
  background: var(--bg);
  color: var(--text);
  font-family: "PingFang SC", -apple-system, "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

.wrap { padding: 32rpx 32rpx 48rpx; }
.num { font-family: "Helvetica Neue", Arial, sans-serif; }
.soft { color: var(--text-soft); }
.small { font-size: 24rpx; }
.gold { color: var(--gold); }
.danger { color: var(--danger); }

.h1 { font-size: 44rpx; font-weight: 600; }
.h2 { font-size: 32rpx; font-weight: 600; }

.card {
  background: var(--card);
  border: 1rpx solid var(--border);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

/* 米色营养卡 */
.nutri {
  background: var(--paper);
  color: var(--ink);
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}
.nutri-label { font-size: 24rpx; color: #4a504a; }
.nutri-kcal { font-size: 96rpx; font-weight: 500; line-height: 1.1; }
.nutri-kcal-unit { font-size: 24rpx; margin-left: 12rpx; color: #4a504a; }
.nutri-row {
  display: flex;
  border-top: 1rpx solid #b9b6aa;
  margin-top: 24rpx;
  padding-top: 20rpx;
}
.nutri-cell { flex: 1; }
.nutri-cell .v { font-size: 40rpx; font-weight: 500; }
.nutri-cell .u { font-size: 22rpx; margin-left: 4rpx; color: #4a504a; }

/* 按钮 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  background: var(--gold);
  color: var(--ink);
  font-weight: 600;
}
.btn.ghost { background: transparent; color: var(--text); border: 1rpx solid var(--border); font-weight: 400; }
.btn.danger { background: transparent; color: var(--danger); border: 1rpx solid #5a3d38; font-weight: 400; }
.btn.disabled { opacity: 0.4; }
.btn-row { display: flex; gap: 20rpx; margin-top: 24rpx; }
.btn-row .btn { flex: 1; }

/* 胶囊筛选 */
.chips { white-space: nowrap; margin: 0 -32rpx 20rpx; padding: 0 32rpx; }
.chip {
  display: inline-block;
  padding: 10rpx 26rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--border);
  color: var(--text-soft);
  font-size: 26rpx;
}
.chip.on { background: var(--gold); border-color: var(--gold); color: var(--ink); }

/* 分段切换 */
.seg { display: flex; background: var(--muted); border-radius: 999rpx; padding: 6rpx; margin-bottom: 24rpx; }
.seg-item { flex: 1; text-align: center; padding: 14rpx 0; border-radius: 999rpx; color: var(--text-soft); }
.seg-item.on { background: var(--gold); color: var(--ink); font-weight: 600; }

/* 输入 */
.search {
  display: flex;
  align-items: center;
  height: 80rpx;
  padding: 0 28rpx;
  border-radius: 40rpx;
  background: var(--muted);
  border: 1rpx solid var(--border);
  margin-bottom: 20rpx;
}
.search input { flex: 1; color: var(--text); font-size: 28rpx; }
.ph { color: #6f766f; }

.field { margin-bottom: 28rpx; }
.field-label { font-size: 26rpx; color: var(--text-soft); margin-bottom: 12rpx; }
.input {
  height: 84rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: var(--muted);
  border: 1rpx solid var(--border);
  color: var(--text);
  font-size: 30rpx;
  display: flex;
  align-items: center;
}
.input input { flex: 1; color: var(--text); }

/* 列表行 */
.row { display: flex; align-items: center; justify-content: space-between; }
.grow { flex: 1; min-width: 0; }
.ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.macros { display: flex; flex-wrap: wrap; gap: 4rpx 24rpx; font-size: 24rpx; color: var(--text-soft); margin-top: 8rpx; }

.empty { text-align: center; color: var(--text-soft); padding: 80rpx 0; }

/* 底部弹层 */
.mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; background: rgba(0, 0, 0, 0.55); z-index: 10; }
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 11;
  background: #1d211e;
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  max-height: 85vh;
  box-sizing: border-box;
  overflow-y: auto;
}
