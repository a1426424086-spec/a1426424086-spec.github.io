.new-btn { margin-top: 40rpx; }
.has-bar { padding-bottom: 200rpx; }
.donebar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 8; display: flex; align-items: center; justify-content: space-between; padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom)); background: rgba(20, 18, 15, 0.82); -webkit-backdrop-filter: blur(24px) saturate(180%); backdrop-filter: blur(24px) saturate(180%); border-top: 1rpx solid rgba(245, 239, 227, 0.1); font-size: 30rpx; }
.done-btn { height: 72rpx; line-height: 72rpx; padding: 0 48rpx; border-radius: 36rpx; background: var(--gold); color: var(--ink); font-size: 30rpx; font-weight: 600; }
.sh-name { font-size: 40rpx; font-weight: 700; overflow-wrap: break-word; }
.sh-sub { font-size: 26rpx; color: var(--text-soft); margin-top: 6rpx; }
.unit-seg { margin-top: 32rpx; }
.stepper { display: flex; align-items: center; justify-content: space-between; margin: 36rpx 0 12rpx; }
.sb { width: 88rpx; height: 88rpx; border-radius: 50%; background: var(--fill); color: var(--gold); font-size: 48rpx; line-height: 84rpx; text-align: center; }
.sh-live { text-align: center; font-size: 26rpx; color: var(--text-soft); min-height: 40rpx; }
.sh-live .num { color: var(--gold); font-size: 30rpx; font-weight: 600; }
.sh-live.danger { color: var(--danger); }
.sv-box { flex: 1; display: flex; flex-direction: column; align-items: center; }
.sv { font-size: 80rpx; font-weight: 600; line-height: 96rpx; height: 96rpx; color: var(--text); }
/* 克重：数字始终用衬线显示 */
.sv-wrap { position: relative; display: flex; justify-content: center; min-width: 240rpx; }
/* 输入框放到屏幕外，只负责弹键盘、收数字；光标只用金色那条 */
.sv-ghost { position: absolute; left: -2000rpx; top: 0; width: 200rpx; height: 96rpx; opacity: 0; }
.sv.empty { color: var(--text-faint); }
.sv.editing::after { content: ''; display: inline-block; width: 4rpx; height: 64rpx; margin-left: 8rpx; vertical-align: -6rpx; background: var(--gold); border-radius: 2rpx; animation: caretBlink 1s steps(1) infinite; }
@keyframes caretBlink { 50% { opacity: 0; } }
.sv-hint { font-size: 24rpx; color: var(--text-soft); margin-top: 4rpx; }

/* v3.1 加入后显示底栏，数字与行尾短暂反馈 */
.donebar { transform: translateY(100%); transition: transform .42s cubic-bezier(.32,.72,0,1); pointer-events: none; }
.donebar.show { transform: translateY(0); pointer-events: auto; }
.add-n { display: inline-block; }
@keyframes pop1 { 40% { transform: scale(1.35); color: var(--gold); } }
@keyframes pop2 { 40% { transform: scale(1.35); color: var(--gold); } }
.pop1 { animation: pop1 .34s cubic-bezier(.32,.72,0,1); }
.pop2 { animation: pop2 .34s cubic-bezier(.32,.72,0,1); }
.li-plus { transition: background-color .25s ease, color .25s ease; }
.li-plus.ok { background: var(--gold); color: var(--ink); font-size: 30rpx; font-weight: 700; }
