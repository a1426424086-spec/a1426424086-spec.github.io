.head { align-items: baseline; }
.greet { font-size: 44rpx; font-weight: 600; letter-spacing: 2rpx; }
.date { font-size: 24rpx; }
.back-today { text-align: right; margin-top: 8rpx; }

.kcal { font-size: 112rpx; line-height: 1; color: #f5e6c2; margin-top: 88rpx; }
.kcal-unit { font-size: 24rpx; margin-top: 16rpx; }

.macros3 { margin-top: 64rpx; }

.meals { margin-top: 64rpx; border-bottom: 1rpx solid rgba(255, 248, 230, 0.1); }
.meal { border-top: 1rpx solid rgba(255, 248, 230, 0.1); }
.meal-row { min-height: 112rpx; }
.meal-name { font-size: 28rpx; }
.meal-kcal { font-size: 32rpx; color: var(--c-carb); }

.detail { padding: 0 0 24rpx 24rpx; }
.item { min-height: 96rpx; padding: 12rpx 0; box-sizing: border-box; }
.item-sub { font-size: 22rpx; margin-top: 2rpx; }
.time-pick { display: inline-block; }
.item-kcal { margin-left: 24rpx; font-size: 28rpx; color: var(--text-soft); }
.add { font-size: 24rpx; padding: 20rpx 0 4rpx; }

.more { text-align: center; padding: 40rpx 0 8rpx; letter-spacing: 4rpx; }
