.brand { padding-bottom: 28rpx; margin-bottom: 36rpx; border-bottom: 1rpx solid var(--border); }
.brand-name { font-size: 48rpx; letter-spacing: 6rpx; color: var(--text); }
.brand-sub { font-size: 24rpx; color: var(--text-soft); margin-left: 20rpx; padding-left: 20rpx; border-left: 1rpx solid var(--border); }

.date-bar { margin: 32rpx 0 8rpx; padding-bottom: 20rpx; border-bottom: 1rpx solid var(--border); }
.arrow { width: 80rpx; height: 64rpx; line-height: 60rpx; text-align: center; font-size: 48rpx; color: var(--text); }
.date-text { font-size: 32rpx; }
.back-today { text-align: center; padding: 12rpx 0; }

.nutri { margin-top: 24rpx; }

.meal { padding: 28rpx 28rpx 12rpx; }
.meal > .row { padding-bottom: 16rpx; }
.meal-index { font-size: 34rpx; width: 70rpx; }
.plus {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  border: 1rpx solid #8d958d;
  text-align: center;
  line-height: 86rpx;
  font-size: 48rpx;
  color: var(--text);
}
.item { padding: 18rpx 0; border-top: 1rpx solid var(--border); }
.item-time { width: 110rpx; font-size: 26rpx; }
.item-kcal { margin-left: 16rpx; }

.tip { text-align: center; margin-top: 28rpx; }
