.top { padding: 8rpx 0 24rpx; }
.brand { font-size: 32rpx; letter-spacing: 8rpx; color: var(--text-soft); }
.date-bar { margin-right: -16rpx; }
.arrow { width: 64rpx; height: 64rpx; line-height: 60rpx; text-align: center; font-size: 40rpx; color: var(--text-soft); }
.date-text { font-size: 30rpx; padding: 0 8rpx; }
.back-today { text-align: right; padding: 0 0 12rpx; }

.meal { margin-top: 56rpx; }
.meal-head { padding-bottom: 12rpx; border-bottom: 1rpx solid var(--line-strong); }
.meal-kcal { font-size: 24rpx; margin-right: 24rpx; }
.plus {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 1rpx solid var(--line-strong);
  text-align: center;
  line-height: 52rpx;
  font-size: 34rpx;
  color: var(--gold);
}
.item { min-height: 96rpx; padding: 16rpx 0; border-bottom: 1rpx solid var(--line); box-sizing: border-box; }
.item-time { width: 110rpx; font-size: 26rpx; color: var(--gold-soft); }
.item-kcal { margin-left: 24rpx; font-size: 30rpx; }
.item-empty { padding: 24rpx 0; border-bottom: 1rpx solid var(--line); }

.tip { text-align: center; margin-top: 40rpx; line-height: 1.8; }
