<view class="ambient"></view>
<view class="wrap" style="padding-top: {{topPad}}px">
  <view class="head row">
    <text class="greet serif">{{greeting}}</text>
    <picker mode="date" value="{{date}}" bindchange="onPickDate">
      <text class="date soft">{{dateLabel}}</text>
    </picker>
  </view>
  <view wx:if="{{!isToday}}" class="back-today gold small" hover-class="press" bindtap="backToday">回到今天</view>

  <view class="kcal num">{{totals.kcal}}</view>
  <view class="kcal-unit soft">千卡</view>

  <view class="macros3">
    <view class="m c"><view class="m-line"></view><view class="m-v num">{{totals.carbs}}</view><view class="m-l soft">碳水</view></view>
    <view class="m p"><view class="m-line"></view><view class="m-v num">{{totals.protein}}</view><view class="m-l soft">蛋白质</view></view>
    <view class="m f"><view class="m-line"></view><view class="m-v num">{{totals.fat}}</view><view class="m-l soft">脂肪</view></view>
  </view>

  <view class="meals">
    <view wx:for="{{meals}}" wx:key="name" wx:for-item="meal" wx:for-index="mi" class="meal">
      <view class="meal-row row" hover-class="press" data-i="{{mi}}" bindtap="toggleMeal">
        <text class="meal-name">{{meal.name}}</text>
        <text class="meal-kcal num {{meal.items.length ? '' : 'faint'}}">{{meal.items.length ? meal.kcal : '—'}}</text>
      </view>
      <view wx:if="{{open === mi}}" class="detail">
        <view wx:for="{{meal.items}}" wx:key="id" class="item row">
          <view class="grow" hover-class="press" data-id="{{item.id}}" bindtap="onItemTap">
            <view class="ellipsis">{{item.name}}</view>
            <view class="item-sub soft">
              <picker class="time-pick" mode="time" value="{{item.time}}" data-id="{{item.id}}" bindchange="onTimeChange"><text class="num">{{item.time}}</text></picker>
              <text> · {{item.qty}}</text>
            </view>
          </view>
          <text class="item-kcal num" data-id="{{item.id}}" bindtap="onItemTap">{{item.kcal}}</text>
        </view>
        <view class="add gold" hover-class="press" data-meal="{{meal.name}}" bindtap="addTo">＋ 添加</view>
      </view>
    </view>
  </view>

  <view wx:if="{{count}}" class="more faint small" hover-class="press" bindtap="more">· · ·</view>
</view>
