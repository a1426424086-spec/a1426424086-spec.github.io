<view class="ambient"></view>
<view class="wrap">
  <view class="seg range">
    <view class="seg-item {{range === 7 ? 'on' : ''}}" hover-class="press" data-r="7" bindtap="setRange">近 7 天</view>
    <view class="seg-item {{range === 30 ? 'on' : ''}}" hover-class="press" data-r="30" bindtap="setRange">近 30 天</view>
  </view>

  <block wx:if="{{avg}}">
    <view class="big-kcal num">{{avg.kcal}}</view>
    <view class="big-unit">日均千卡 · 记录 <text class="num">{{recorded}}</text> 天</view>
    <view class="macros3 gap-l">
      <view class="m c"><view class="m-line"></view><view class="m-v num">{{avg.carbs}}</view><view class="m-l">碳水</view></view>
      <view class="m p"><view class="m-line"></view><view class="m-v num">{{avg.protein}}</view><view class="m-l">蛋白质</view></view>
      <view class="m f"><view class="m-line"></view><view class="m-v num">{{avg.fat}}</view><view class="m-l">脂肪</view></view>
    </view>
  </block>

  <view class="chart gap-l">
    <view wx:for="{{bars}}" wx:key="date" class="bar-col" hover-class="press" data-date="{{item.date}}" bindtap="openDay">
      <view class="bar-track">
        <view class="bar {{item.today ? 'today' : ''}}" style="height: {{item.height}}%"></view>
      </view>
      <view class="bar-label {{range > 7 ? 'num' : ''}} {{item.today ? 'gold' : 'faint'}}">{{item.label}}</view>
    </view>
  </view>

  <view class="gap-l" wx:if="{{avg}}">
    <view wx:for="{{mealShare}}" wx:key="name" class="share row">
      <text class="share-name">{{item.name}}</text>
      <view class="share-track grow"><view class="share-bar" style="width: {{item.pct}}%"></view></view>
      <text class="share-pct num">{{item.pct}}%</text>
    </view>
  </view>

  <view class="list gap-l">
    <view wx:for="{{history}}" wx:key="date" class="li row" hover-class="press" data-date="{{item.date}}" bindtap="openDay">
      <view class="grow">{{item.title}}<text class="soft small hist-week">{{item.week}}</text></view>
      <text class="li-num num">{{item.kcal}}</text>
    </view>
  </view>
  <view wx:if="{{hasMore}}" class="more soft small" hover-class="press" bindtap="more">更早的记录</view>
  <view wx:if="{{!history.length}}" class="empty">还没有记录</view>
</view>
