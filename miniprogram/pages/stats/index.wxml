<view class="wrap">
  <view class="soft small intro">按本机记录计算，有效蛋白为自定义折算估算</view>

  <view class="seg range">
    <view class="seg-item {{range === 7 ? 'on' : ''}}" hover-class="press" data-r="7" bindtap="setRange">近 <text class="num">7</text> 天</view>
    <view class="seg-item {{range === 30 ? 'on' : ''}}" hover-class="press" data-r="30" bindtap="setRange">近 <text class="num">30</text> 天</view>
  </view>

  <view class="chart-section">
    <view class="row section-head">
      <text class="label">每日热量</text>
      <text class="soft small">已记录 <text class="num">{{recorded}} / {{range}}</text> 天</text>
    </view>
    <view class="chart">
      <view wx:for="{{bars}}" wx:key="date" class="bar-col" hover-class="press" data-date="{{item.date}}" bindtap="openDay">
        <view class="bar-val num" wx:if="{{range === 7 && item.kcal}}">{{item.kcal}}</view>
        <view class="bar-track">
          <view class="bar {{item.today ? 'today' : ''}}" style="height: {{item.height}}%"></view>
        </view>
        <view class="bar-label {{range > 7 ? 'num' : ''}} {{item.today ? 'gold' : 'soft'}}">{{item.label}}</view>
      </view>
    </view>
  </view>

  <view class="nutri section" wx:if="{{avg}}">
    <view class="label">日均营养</view>
    <view class="nutri-head">
      <view class="ring" style="{{ringStyle}}"><view class="ring-hole"></view></view>
      <view>
        <view class="nutri-label">有记录日的日均</view>
        <view><text class="nutri-kcal num">{{avg.kcal}}</text><text class="nutri-kcal-unit">千卡</text></view>
      </view>
    </view>
    <view class="nutri-row">
      <view class="nutri-cell"><view class="nutri-label"><text class="dot c"></text>碳水</view><text class="v num">{{avg.carbs}}</text><text class="u">克</text></view>
      <view class="nutri-cell"><view class="nutri-label"><text class="dot p"></text>蛋白质</view><text class="v num">{{avg.protein}}</text><text class="u">克</text></view>
      <view class="nutri-cell"><view class="nutri-label">有效蛋白</view><text class="v num">{{avg.effective}}</text><text class="u">克</text></view>
      <view class="nutri-cell"><view class="nutri-label"><text class="dot f"></text>脂肪</view><text class="v num">{{avg.fat}}</text><text class="u">克</text></view>
    </view>
  </view>

  <view class="section" wx:if="{{avg}}">
    <view class="label section-head">餐次热量占比</view>
    <view wx:for="{{mealShare}}" wx:key="name" class="share row">
      <text class="share-name">{{item.name}}</text>
      <view class="share-track grow"><view class="share-bar" style="width: {{item.pct}}%"></view></view>
      <text class="share-pct num">{{item.pct}}%</text>
    </view>
  </view>

  <view class="label section section-head">历史记录</view>
  <view class="history-list">
    <view wx:for="{{history}}" wx:key="date" class="hist row" hover-class="press" data-date="{{item.date}}" bindtap="openDay">
      <view class="grow">
        <view><text wx:for="{{item.titleParts}}" wx:for-item="part" wx:for-index="partIndex" wx:key="partIndex" class="{{partIndex % 2 ? 'num' : ''}}">{{part}}</text><text class="soft small hist-week">{{item.week}} · <text class="num">{{item.year}}</text></text></view>
        <view class="soft small"><text class="num">{{item.count}}</text> 项食材</view>
      </view>
      <view class="hist-kcal"><text class="num">{{item.kcal}}</text><text class="soft small"> 千卡 ›</text></view>
    </view>
  </view>
  <view wx:if="{{hasMore}}" class="btn ghost more" hover-class="press" bindtap="more">加载更早的记录</view>
  <view wx:if="{{!history.length}}" class="empty">还没有记录，去「配餐」添加第一餐吧</view>
</view>
