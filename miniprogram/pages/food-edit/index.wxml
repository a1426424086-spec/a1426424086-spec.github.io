<view class="pg">
  <view class="sec">基本信息</view>
  <view class="list">
    <view class="fr"><text class="fr-l">名称</text><view class="fr-v"><input placeholder="如：鸡胸肉、全麦面包" placeholder-class="ph" value="{{name}}" data-k="name" bindinput="onInput" /></view></view>
    <picker range="{{categories}}" value="{{categoryIndex}}" bindchange="onCategory">
      <view class="fr" hover-class="press" hover-start-time="0" hover-stay-time="100"><text class="fr-l">分类</text><text class="fr-v">{{categoryIndex >= 0 ? categories[categoryIndex] : '请选择分类'}}</text><view class="li-chev"></view></view>
    </picker>
  </view>

  <view class="sec"><text>营养</text><text>每 100 克</text></view>
  <view class="list">
    <view class="fr"><text class="fr-l">碳水</text><view class="fr-v"><input type="digit" value="{{carbs}}" data-k="carbs" bindinput="onInput" /></view><text class="fr-u">克</text></view>
    <view class="fr"><text class="fr-l">蛋白质</text><view class="fr-v"><input type="digit" value="{{protein}}" data-k="protein" bindinput="onInput" /></view><text class="fr-u">克</text></view>
    <view class="fr"><text class="fr-l">脂肪</text><view class="fr-v"><input type="digit" value="{{fat}}" data-k="fat" bindinput="onInput" /></view><text class="fr-u">克</text></view>
  </view>

  <view class="sec">计算结果</view>
  <view class="list calc2">
    <view class="calc-c"><view class="calc-l">热量</view><text class="num calc-v">{{kcal}}</text><text class="fr-u">千卡</text></view>
    <view class="calc-c"><view class="calc-l">有效蛋白</view><text class="num calc-v">{{effective}}</text><text class="fr-u">克</text></view>
  </view>

  <view class="sec">蛋白折算比例</view>
  <view class="list">
    <view class="fr fr-seg">
      <view class="seg grow"><view class="seg-knob" style="width: calc((100% - 8rpx) / 4); transform: translateX({{(factorCustom ? 3 : (factor === '100' ? 0 : (factor === '80' ? 1 : 2))) * 100}}%)"></view>
        <view hover-class="press" hover-start-time="0" hover-stay-time="100" class="seg-item {{!factorCustom && factor === '100' ? 'on' : ''}}" data-v="100" bindtap="setFactor"><text class="num">100</text>%</view>
        <view hover-class="press" hover-start-time="0" hover-stay-time="100" class="seg-item {{!factorCustom && factor === '80' ? 'on' : ''}}" data-v="80" bindtap="setFactor"><text class="num">80</text>%</view>
        <view hover-class="press" hover-start-time="0" hover-stay-time="100" class="seg-item {{!factorCustom && factor === '50' ? 'on' : ''}}" data-v="50" bindtap="setFactor"><text class="num">50</text>%</view>
        <view hover-class="press" hover-start-time="0" hover-stay-time="100" class="seg-item {{factorCustom ? 'on' : ''}}" data-v="custom" bindtap="setFactor">自定义</view>
      </view>
    </view>
    <view class="fr" wx:if="{{factorCustom}}"><text class="fr-l">比例</text><view class="fr-v"><input type="digit" value="{{factor}}" bindinput="onFactorInput" /></view><text class="fr-u">%</text></view>
  </view>

  <view class="ops">
    <view hover-class="press" hover-start-time="0" hover-stay-time="100" class="btn" bindtap="save">保存食材</view>
    <view hover-class="press" hover-start-time="0" hover-stay-time="100" wx:if="{{id}}" class="btn danger op2" bindtap="remove">删除食材</view>
  </view>
</view>
