<view class="pg">
  <view class="seg"><view class="seg-knob" style="width: calc((100% - 8rpx) / 2); transform: translateX({{tab === 'ref' ? 100 : 0}}%)"></view>
    <view hover-class="press" hover-start-time="0" hover-stay-time="100" class="seg-item {{tab === 'mine' ? 'on' : ''}}" data-t="mine" bindtap="setTab">我的食谱</view>
    <view hover-class="press" hover-start-time="0" hover-stay-time="100" class="seg-item {{tab === 'ref' ? 'on' : ''}}" data-t="ref" bindtap="setTab">参考食谱</view>
  </view>

  <block wx:if="{{tab === 'mine'}}">
    <view class="list new-list">
      <view class="li add-row" hover-class="row-press" hover-start-time="0" hover-stay-time="100" bindtap="createNew"><text class="add-plus">＋</text><text>新建食谱</text></view>
    </view>
    <block wx:if="{{mine.length}}">
      <view class="sec"><text>我的食谱</text><text>千卡</text></view>
      <view class="list">
        <view hover-class="row-press" hover-start-time="0" hover-stay-time="100" wx:for="{{mine}}" wx:key="id" class="li" data-id="{{item.id}}" data-src="mine" bindtap="open">
          <view class="li-main"><view class="li-name">{{item.name}}</view></view>
          <text class="li-num num">{{item.kcal}}</text>
          <view class="li-chev"></view>
        </view>
      </view>
    </block>
    <view wx:else="" class="empty">
      <view>还没有食谱</view>
      <view class="small">点上面「新建食谱」，或在配餐页底部点「存入食谱夹」</view>
    </view>
  </block>

  <block wx:else="">
    <block wx:for="{{groups}}" wx:key="name" wx:for-item="g">
      <view class="sec"><text>{{g.name}}</text><text>千卡</text></view>
      <view class="list">
        <view hover-class="row-press" hover-start-time="0" hover-stay-time="100" wx:for="{{g.items}}" wx:key="id" class="li" data-id="{{item.id}}" data-src="ref" bindtap="open">
          <view class="li-main"><view class="li-name">食谱 {{item.name}}</view></view>
          <text class="li-num num">{{item.kcal}}</text>
          <view class="li-chev"></view>
        </view>
      </view>
    </block>
  </block>
</view>
