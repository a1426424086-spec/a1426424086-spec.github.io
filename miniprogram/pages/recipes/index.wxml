<view class="ambient"></view>
<view class="wrap">
  <view class="seg">
    <view hover-class="press" class="seg-item {{tab === 'mine' ? 'on' : ''}}" data-t="mine" bindtap="setTab">我的食谱</view>
    <view hover-class="press" class="seg-item {{tab === 'ref' ? 'on' : ''}}" data-t="ref" bindtap="setTab">参考食谱</view>
  </view>

  <block wx:if="{{tab === 'mine'}}">
    <view class="list" wx:if="{{mine.length}}">
      <view hover-class="press" wx:for="{{mine}}" wx:key="id" class="li row" data-id="{{item.id}}" data-src="mine" bindtap="open">
        <view class="grow ellipsis">{{item.name}}</view>
        <text class="li-num num">{{item.kcal}}</text>
      </view>
    </view>
    <view wx:else class="empty">
      <view>还没有食谱</view>
      <view class="small">在配餐页点「· · ·」存入，或从参考食谱存一份</view>
    </view>
  </block>

  <block wx:else>
    <view wx:for="{{groups}}" wx:key="name" wx:for-item="g" class="group">
      <view class="group-title soft small">{{g.name}}</view>
      <view class="list">
        <view hover-class="press" wx:for="{{g.items}}" wx:key="id" class="li row" data-id="{{item.id}}" data-src="ref" bindtap="open">
          <view class="grow ellipsis">食谱 {{item.name}}</view>
          <text class="li-num num">{{item.kcal}}</text>
        </view>
      </view>
    </view>
  </block>
</view>
