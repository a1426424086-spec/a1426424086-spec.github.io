.sub { margin: 0 0 32rpx; line-height: 1.8; }
.recipe-list { border-top: 1rpx solid var(--line-strong); border-bottom: 1rpx solid var(--line-strong); }
.recipe-list.is-empty { border: 0; }
.recipe-row { min-height: 112rpx; padding: 24rpx 0; box-sizing: border-box; border-bottom: 1rpx solid var(--line); }
.recipe-row:last-child { border-bottom-color: var(--line-strong); }
.recipe-list > .recipe-row:last-child { border-bottom: 0; }
.recipe-row .h2 { font-size: 28rpx; font-weight: 400; }
.kcal { flex-shrink: 0; margin-left: 24rpx; font-size: 30rpx; }
.group-title { margin-top: 56rpx; padding-bottom: 16rpx; border-bottom: 1rpx solid var(--line-strong); }
