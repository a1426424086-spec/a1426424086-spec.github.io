.sub { margin: 0 0 32rpx; line-height: 1.8; }
.summary-label { margin-bottom: 16rpx; }
.nutri-row { margin-top: 32rpx; }
.meal { margin-top: 56rpx; border-bottom: 1rpx solid var(--line-strong); }
.meal-head { padding-bottom: 16rpx; border-bottom: 1rpx solid var(--line-strong); }
.meal-title { padding-top: 20rpx; }
.item { min-height: 112rpx; padding: 20rpx 0; box-sizing: border-box; border-bottom: 1rpx solid var(--line); }
.item:last-child { border-bottom: 0; }
.item-kcal { flex-shrink: 0; margin-left: 24rpx; font-size: 30rpx; }
.note { padding: 20rpx 0; line-height: 1.8; }
.meal + .sub { margin-top: 40rpx; }
