<view class="ambient"></view>
<view class="wrap" wx:if="{{missing}}">
  <view class="empty">食谱不存在</view>
</view>

<view class="wrap" wx:else>
  <view class="big-kcal num">{{totals.kcal}}</view>
  <view class="big-unit">千卡</view>
  <view class="macros3 gap-l">
    <view class="m c"><view class="m-line"></view><view class="m-v num">{{totals.carbs}}</view><view class="m-l">碳水</view></view>
    <view class="m p"><view class="m-line"></view><view class="m-v num">{{totals.protein}}</view><view class="m-l">蛋白质</view></view>
    <view class="m f"><view class="m-line"></view><view class="m-v num">{{totals.fat}}</view><view class="m-l">脂肪</view></view>
  </view>

  <view wx:for="{{meals}}" wx:key="name" wx:for-item="meal" class="meal">
    <view class="row meal-head">
      <text>{{meal.name}}</text>
      <text class="num meal-kcal">{{meal.kcal}}</text>
    </view>
    <view wx:for="{{meal.items}}" wx:key="key" class="item row">
      <view class="grow ellipsis">{{item.name}}<text class="soft small">  {{item.qty}}</text></view>
      <text class="num soft item-kcal">{{item.kcal}}</text>
    </view>
  </view>

  <picker mode="date" value="{{date}}" bindchange="onPickDate">
    <view class="btn use" hover-class="press">选择日期并使用</view>
  </picker>
  <view hover-class="press" wx:if="{{src === 'ref'}}" class="link soft small" bindtap="copy">存入我的食谱</view>
  <view hover-class="press" wx:else class="link danger small" bindtap="remove">删除食谱</view>
</view>
