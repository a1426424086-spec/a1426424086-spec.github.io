.request-page { --ease: cubic-bezier(.32,.72,0,1); padding-bottom: calc(64rpx + env(safe-area-inset-bottom)); }
.intro { border: 1rpx solid var(--gold); padding: 28rpx 32rpx; font-size: 26rpx; color: var(--text); }
.intro-more { margin-top: 12rpx; }
.last-row { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 32rpx 0; font-size: 22rpx; color: var(--text-soft); }
.withdraw { flex-shrink: 0; padding: 16rpx 0 16rpx 24rpx; }
.form-field { position: relative; }
.form-field + .form-field::before { content: ''; position: absolute; top: 0; left: 32rpx; right: 0; height: 1rpx; background: var(--sep); }
.fr-v input { font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif; font-variant-numeric: tabular-nums; text-align: right; }
.seg-knob { transition: transform .3s var(--ease); }
.field-error { color: var(--danger); font-size: 22rpx; padding: 0 32rpx 16rpx; }
.activity { position: relative; border: 1rpx solid var(--sep); transition: border-color .2s ease; }
.activity + .activity { margin-top: 12rpx; }
.activity.selected { border-color: var(--gold); }
.activity-desc { font-size: 26rpx; color: var(--text-soft); margin-top: 6rpx; }
.activity-factor { color: var(--text-soft); }
.selected .activity-factor { color: var(--gold); }
.activity-check { position: absolute; top: 14rpx; right: 26rpx; font-size: 22rpx; color: var(--gold); }
.estimate { margin-top: 32rpx; padding: 28rpx 32rpx; font-size: 26rpx; }
.estimate-value { color: var(--gold); font-size: 48rpx; font-weight: 600; margin: 0 6rpx; }
.estimate-target { margin-top: 12rpx; color: var(--text-soft); }
.target-value { color: var(--gold); font-size: 30rpx; margin: 0 6rpx; }
.message-card { padding: 28rpx 32rpx; }
.message-card textarea { display: block; width: 100%; height: 200rpx; font-size: 30rpx; color: var(--text); line-height: 1.5; }
.message-count { text-align: right; margin-top: 12rpx; font-size: 22rpx; color: var(--text-soft); }
.ops { margin-top: 48rpx; }
.privacy { color: var(--text-soft); font-size: 22rpx; margin-bottom: 24rpx; }
.submit-error, .storage-error { color: var(--danger); font-size: 22rpx; margin-bottom: 16rpx; }
.ops button { width: 100%; padding: 0; margin-left: 0; margin-right: 0; border: 0; line-height: inherit; font-family: inherit; }
.ops button::after { border: 0; }
.ops button[disabled] { background: var(--gold); color: var(--ink); }
.op2 { margin-top: 24rpx; }
