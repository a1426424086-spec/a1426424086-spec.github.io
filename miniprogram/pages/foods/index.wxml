<view class="wrap">
  <view class="row head">
    <view>
      <view class="h1">食材库</view>
      <view class="soft small">{{total}} 项食材 · 营养值均为每 100 克</view>
    </view>
    <view class="btn new" bindtap="add">+ 新增</view>
  </view>

  <view wx:if="{{showGoods}}" class="card goods-entry row" bindtap="openGoods">
    <view class="grow">
      <view class="h2">好物推荐</view>
      <view class="soft small">常吃的包装食品，一键导入食材库</view>
    </view>
    <text class="gold">查看 ›</text>
  </view>

  <view class="search">
    <input placeholder="搜索食材库" placeholder-class="ph" value="{{keyword}}" bindinput="onSearch" confirm-type="search" />
  </view>

  <scroll-view scroll-x class="chips" enhanced="{{true}}" show-scrollbar="{{false}}">
    <view wx:for="{{categories}}" wx:key="*this" class="chip {{item === category ? 'on' : ''}}" data-c="{{item}}" bindtap="onCategory">{{item}}</view>
  </scroll-view>

  <view wx:for="{{list}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="edit">
    <view class="row">
      <view class="grow ellipsis">{{item.name}}</view>
      <view class="num">{{item.kcal}}<text class="soft small"> 千卡</text></view>
    </view>
    <view class="macros">
      <text>{{item.category}}</text>
      <text>碳水 {{item.carbs}}</text>
      <text>蛋白质 {{item.protein}}</text>
      <text>脂肪 {{item.fat}}</text>
      <text>折算 {{item.factor}}%</text>
      <text wx:if="{{item.serving}}">{{item.serving}}</text>
    </view>
  </view>

  <view wx:if="{{!list.length}}" class="empty">没找到这项食材</view>
</view>
