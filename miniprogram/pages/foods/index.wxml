<view class="ambient"></view>
<view class="wrap">
  <view class="head row">
    <view class="search grow">
      <input placeholder="搜索食材" placeholder-class="ph" value="{{keyword}}" bindinput="onSearch" confirm-type="search" />
    </view>
    <view hover-class="press" class="add-btn" bindtap="add">+</view>
  </view>

  <view hover-class="press" wx:if="{{showGoods}}" class="li row" bindtap="openGoods">
    <view class="grow">好物推荐</view>
    <text class="gold">查看 ›</text>
  </view>

  <scroll-view scroll-x class="chips" enhanced="{{true}}" show-scrollbar="{{false}}">
    <view hover-class="press" wx:for="{{categories}}" wx:key="*this" class="chip {{item === category ? 'on' : ''}}" data-c="{{item}}" bindtap="onCategory">{{item}}</view>
  </scroll-view>

  <view class="cap faint">千卡 / 100 克</view>
  <view class="list">
    <view hover-class="press" wx:for="{{list}}" wx:key="id" class="li row" data-id="{{item.id}}" bindtap="edit">
      <view class="grow ellipsis">{{item.name}}</view>
      <text class="li-num dim num">{{item.kcal}}</text>
    </view>
  </view>

  <view wx:if="{{!list.length}}" class="empty">没找到这项食材</view>
</view>
